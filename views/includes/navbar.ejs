<style>
  .btn-search {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .btn-search:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 1rem;
    font-size: 1rem;
  }

  /* Responsiveness fixes */
  .navbar .navbar-collapse {
    flex-wrap: wrap;
  }

  form[role="search"] {
    flex-wrap: nowrap;
  }

  @media (min-width: 768px) and (max-width: 991px) {
    form[role="search"] {
      max-width: 260px;
    }
  }

  @media (max-width: 767px) {
    .navbar-nav {
      margin-bottom: 0.5rem;
    }
    form[role="search"] {
      width: 100%;
      margin: 0.5rem 0;
    }
    .search-inp {
      flex: 1 1 auto;
      min-width: 0; /* prevents input overflow on small screens */
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <a class="navbar-brand" href="/listings">
      <i class="fa-regular fa-compass"></i>
    </a>

    <button class="navbar-toggler" type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- ONE collapse container for everything: links, search, auth -->
    <div class="collapse navbar-collapse" id="navbarNav">

      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link" href="/listings">Explore</a>
        </li>
      </ul>

      <form class="d-flex mx-md-auto" role="search" action="/listings/search" method="GET">
        <input class="form-control search-inp me-2"
          type="search"
          placeholder="Search destination"
          name="city" />
        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
      </form>

      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/listings/new">Airbnb your home</a>
        </li>
        <% if (!locals.currUser) { %>
          <li class="nav-item">
            <a class="nav-link" href="/signup"><b>SignUp</b></a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/login"><b>Login</b></a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link" href="/logout"><b>LogOut</b></a>
          </li>
        <% } %>
      </ul>

    </div>
  </div>
</nav>